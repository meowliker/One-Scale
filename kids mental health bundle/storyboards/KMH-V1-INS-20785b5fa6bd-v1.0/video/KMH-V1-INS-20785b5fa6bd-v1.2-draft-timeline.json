 "vo_lines": [
  {
   "picture": "S01",
   "shot": "S01",
   "text": "Is your kid always dysregulated, melting down over little things?",
   "cut_start": 0.0,
   "cut_end": 4.49,
   "out_on": 0.0,
   "out_off": 4.39,
   "src_on": 0.0,
   "src_off": 4.39
  },
  {
   "picture": "S02",
   "shot": "S02",
   "text": "Then the shoes feel wrong.",
   "cut_start": 4.49,
   "cut_end": 6.01,
   "out_on": 4.59,
   "out_off": 5.91,
   "src_on": 4.82,
   "src_off": 6.14
  },
  {
   "picture": "S03",
   "shot": "S03",
   "text": "Their whole body goes rigid.",
   "cut_start": 6.01,
   "cut_end": 7.87,
   "out_on": 6.11,
   "out_off": 7.77,
   "src_on": 6.34,
   "src_off": 8.0
  },
  {
   "picture": "S04",
   "shot": "S04",
   "text": "Big feelings get trapped inside.",
   "cut_start": 7.87,
   "cut_end": 9.82,
   "out_on": 7.97,
   "out_off": 9.72,
   "src_on": 8.48,
   "src_off": 10.23
  },
  {
   "picture": "S05",
   "shot": "S05",
   "text": "Constant tears, slamming doors. And that",
   "cut_start": 9.82,
   "cut_end": 12.74,
   "out_on": 9.92,
   "out_off": 12.74,
   "src_on": 10.78,
   "src_off": 13.6
  },
  {
   "picture": "S06",
   "shot": "S06",
   "text": "tense feeling just won't go away.",
   "cut_start": 12.74,
   "cut_end": 14.98,
   "out_on": 12.74,
   "out_off": 14.88,
   "src_on": 13.6,
   "src_off": 15.74
  },
  {
   "picture": "S07",
   "shot": "S07",
   "text": "Soon, asking for something simple starts feeling like a risk.",
   "cut_start": 14.98,
   "cut_end": 18.58,
   "out_on": 15.08,
   "out_off": 18.48,
   "src_on": 16.53,
   "src_off": 19.93
  },
  {
   "picture": "S08",
   "shot": "S08",
   "text": "You brace yourself mornings,",
   "cut_start": 18.58,
   "cut_end": 20.68,
   "out_on": 18.68,
   "out_off": 20.58,
   "src_on": 20.38,
   "src_off": 22.28
  },
  {
   "picture": "S09",
   "shot": "S09",
   "text": "dinners,",
   "cut_start": 20.68,
   "cut_end": 21.32,
   "out_on": 20.78,
   "out_off": 21.22,
   "src_on": 22.5,
   "src_off": 22.94
  },
  {
   "picture": "S10",
   "shot": "S10",
   "text": "bedtimes.",
   "cut_start": 21.32,
   "cut_end": 22.22,
   "out_on": 21.42,
   "out_off": 22.12,
   "src_on": 23.2,
   "src_off": 23.9
  },
  {
   "picture": "S11",
   "shot": "S11",
   "text": "And instead of enjoying your kid,",
   "cut_start": 22.22,
   "cut_end": 23.97,
   "out_on": 22.32,
   "out_off": 23.88,
   "src_on": 24.38,
   "src_off": 25.94
  },
  {
   "picture": "S12",
   "shot": "S12",
   "text": "you're waiting for the next meltdown to start.",
   "cut_start": 23.97,
   "cut_end": 26.16,
   "out_on": 24.06,
   "out_off": 26.06,
   "src_on": 26.12,
   "src_off": 28.12
  },
  {
   "picture": "S13",
   "shot": "S13",
   "text": "Day after day, your home feels loud,",
   "cut_start": 26.16,
   "cut_end": 28.68,
   "out_on": 26.26,
   "out_off": 28.58,
   "src_on": 28.76,
   "src_off": 31.08
  },
  {
   "picture": "S14",
   "shot": "S14",
   "text": "tense, and exhausting,",
   "cut_start": 28.68,
   "cut_end": 30.38,
   "out_on": 28.78,
   "out_off": 30.28,
   "src_on": 31.28,
   "src_off": 32.78
  },
  {
   "picture": "S15",
   "shot": "S15",
   "text": "leaving you drained before your day is even over.",
   "cut_start": 30.38,
   "cut_end": 32.82,
   "out_on": 30.48,
   "out_off": 32.72,
   "src_on": 33.32,
   "src_off": 35.56
  },
  {
   "picture": "S16",
   "shot": "S16",
   "text": "What if your kid has been asking for a different kind of support?",
   "cut_start": 32.82,
   "cut_end": 35.66,
   "out_on": 32.92,
   "out_off": 35.56,
   "src_on": 36.46,
   "src_off": 39.1
  },
  {
   "picture": "S17",
   "shot": "S17",
   "text": "Just one printable feelings chart with your kid every day",
   "cut_start": 35.66,
   "cut_end": 38.82,
   "out_on": 35.76,
   "out_off": 38.82,
   "src_on": 39.84,
   "src_off": 42.9
  },
  {
   "picture": "S18",
   "shot": "S18",
   "text": "can help them name feelings,",
   "cut_start": 38.82,
   "cut_end": 40.32,
   "out_on": 38.82,
   "out_off": 40.32,
   "src_on": 42.9,
   "src_off": 44.4
  },
  {
   "picture": "S19",
   "shot": "S19",
   "text": "and leave your home feeling lighter and more peaceful.",
   "cut_start": 40.32,
   "cut_end": 43.22,
   "out_on": 40.32,
   "out_off": 43.12,
   "src_on": 44.4,
   "src_off": 47.2
  },
  {
   "picture": "S20",
   "shot": "S20",
   "text": "No more bracing yourself before every request.",
   "cut_start": 43.22,
   "cut_end": 45.82,
   "out_on": 43.32,
   "out_off": 45.72,
   "src_on": 47.92,
   "src_off": 50.32
  },
  {
   "picture": "S21",
   "shot": "S21",
   "text": "No more worrying about meltdowns or tantrums,",
   "cut_start": 45.82,
   "cut_end": 48.08,
   "out_on": 45.92,
   "out_off": 48.08,
   "src_on": 50.74,
   "src_off": 52.9
  },
  {
   "picture": "S22",
   "shot": "S22",
   "text": "just a kid who names feelings,",
   "cut_start": 48.08,
   "cut_end": 50.36,
   "out_on": 48.08,
   "out_off": 50.26,
   "src_on": 52.9,
   "src_off": 55.08
  },
  {
   "picture": "S23",
   "shot": "S23",
   "text": "calmer evenings",
   "cut_start": 50.36,
   "cut_end": 51.515,
   "out_on": 50.46,
   "out_off": 51.42,
   "src_on": 55.44,
   "src_off": 56.4
  },
  {
   "picture": "S24",
   "shot": "S24",
   "text": "and time to enjoy them.",
   "cut_start": 51.515,
   "cut_end": 52.98,
   "out_on": 51.61,
   "out_off": 52.88,
   "src_on": 56.59,
   "src_off": 57.86
  },
  {
   "picture": "S25",
   "shot": "S25",
   "text": "Add one feelings chart a day from the free Kids Mental Health Bundle",
   "cut_start": 52.98,
   "cut_end": 56.29,
   "out_on": 53.08,
   "out_off": 56.29,
   "src_on": 58.65,
   "src_off": 61.86
  },
  {
   "picture": "S26",
   "shot": "S26",
   "text": "and give your kid support.",
   "cut_start": 56.29,
   "cut_end": 58.08,
   "out_on": 56.29,
   "out_off": 57.98,
   "src_on": 61.86,
   "src_off": 63.55
  },
  {
   "picture": "S28",
   "shot": "S27",
   "text": "Grab yours free.",
   "cut_start": 58.68,
   "cut_end": 61.2,
   "out_on": 58.78,
   "out_off": 59.65,
   "src_on": 64.16,
   "src_off": 65.03
  }
 ],
