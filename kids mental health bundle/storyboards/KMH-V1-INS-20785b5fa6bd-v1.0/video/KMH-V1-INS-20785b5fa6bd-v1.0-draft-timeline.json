 "vo_lines": [
  {
   "shot": "S01",
   "text": "Is your kid always dysregulated, melting down over little things?",
   "shot_start": 0.0,
   "shot_end": 2.703,
   "out_on": 0.486,
   "out_off": 4.548,
   "drift_s": 0.486,
   "src_on": 0.486168,
   "src_off": 4.5483
  },
  {
   "shot": "S02",
   "text": "Then the shoes feel wrong.",
   "shot_start": 2.703,
   "shot_end": 4.204,
   "out_on": 4.898,
   "out_off": 6.217,
   "drift_s": 2.195,
   "src_on": 5.29986,
   "src_off": 6.61914
  },
  {
   "shot": "S03",
   "text": "Their whole body goes rigid.",
   "shot_start": 4.204,
   "shot_end": 5.939,
   "out_on": 6.567,
   "out_off": 7.818,
   "drift_s": 2.363,
   "src_on": 7.02254,
   "src_off": 8.27347
  },
  {
   "shot": "S04",
   "text": "Big feelings get trapped inside.",
   "shot_start": 5.939,
   "shot_end": 8.008,
   "out_on": 8.168,
   "out_off": 10.105,
   "drift_s": 2.229,
   "src_on": 8.75889,
   "src_off": 10.6957
  },
  {
   "shot": "S05",
   "text": "Constant tears, slamming doors. And that",
   "shot_start": 8.008,
   "shot_end": 10.277,
   "out_on": 10.455,
   "out_off": 13.478,
   "drift_s": 2.447,
   "src_on": 11.3588,
   "src_off": 14.3822
  },
  {
   "shot": "S06",
   "text": "tense feeling just won't go away.",
   "shot_start": 10.277,
   "shot_end": 12.813,
   "out_on": 13.658,
   "out_off": 15.498,
   "drift_s": 3.381,
   "src_on": 14.5625,
   "src_off": 16.402
  },
  {
   "shot": "S07",
   "text": "Soon, asking for something simple starts feeling like a risk.",
   "shot_start": 12.813,
   "shot_end": 16.45,
   "out_on": 15.848,
   "out_off": 19.288,
   "drift_s": 3.035,
   "src_on": 17.1275,
   "src_off": 20.5678
  },
  {
   "shot": "S08",
   "text": "You brace yourself mornings,",
   "shot_start": 16.45,
   "shot_end": 18.051,
   "out_on": 19.638,
   "out_off": 21.602,
   "drift_s": 3.188,
   "src_on": 21.381,
   "src_off": 23.345
  },
  {
   "shot": "S09",
   "text": "dinners,",
   "shot_start": 18.051,
   "shot_end": 18.685,
   "out_on": 21.88,
   "out_off": 22.394,
   "drift_s": 3.829,
   "src_on": 23.6226,
   "src_off": 24.1365
  },
  {
   "shot": "S10",
   "text": "bedtimes.",
   "shot_start": 18.685,
   "shot_end": 19.386,
   "out_on": 22.604,
   "out_off": 23.258,
   "drift_s": 3.919,
   "src_on": 24.3468,
   "src_off": 25.001
  },
  {
   "shot": "S11",
   "text": "And instead of enjoying your kid,",
   "shot_start": 19.386,
   "shot_end": 21.021,
   "out_on": 23.608,
   "out_off": 24.978,
   "drift_s": 4.222,
   "src_on": 25.5726,
   "src_off": 26.9429
  },
  {
   "shot": "S12",
   "text": "you're waiting for the next meltdown to start.",
   "shot_start": 21.021,
   "shot_end": 23.157,
   "out_on": 25.328,
   "out_off": 27.286,
   "drift_s": 4.307,
   "src_on": 27.6439,
   "src_off": 29.6015
  },
  {
   "shot": "S13",
   "text": "Day after day, your home feels loud,",
   "shot_start": 23.157,
   "shot_end": 25.826,
   "out_on": 27.636,
   "out_off": 29.846,
   "drift_s": 4.479,
   "src_on": 31.7928,
   "src_off": 34.003
  },
  {
   "shot": "S14",
   "text": "tense, and exhausting,",
   "shot_start": 25.826,
   "shot_end": 27.728,
   "out_on": 30.078,
   "out_off": 31.252,
   "drift_s": 4.252,
   "src_on": 34.235,
   "src_off": 35.4093
  },
  {
   "shot": "S15",
   "text": "leaving you drained before your day is even over.",
   "shot_start": 27.728,
   "shot_end": 30.297,
   "out_on": 31.602,
   "out_off": 34.114,
   "drift_s": 3.874,
   "src_on": 35.9299,
   "src_off": 38.4424
  },
  {
   "shot": "S16",
   "text": "What if your kid has been asking for a different kind of support?",
   "shot_start": 30.297,
   "shot_end": 33.3,
   "out_on": 34.464,
   "out_off": 37.329,
   "drift_s": 4.167,
   "src_on": 39.435,
   "src_off": 42.3004
  },
  {
   "shot": "S17",
   "text": "Just one printable feelings chart with your kid every day",
   "shot_start": 33.3,
   "shot_end": 35.836,
   "out_on": 37.679,
   "out_off": 40.707,
   "drift_s": 4.379,
   "src_on": 43.382,
   "src_off": 46.4096
  },
  {
   "shot": "S18",
   "text": "can help them name feelings,",
   "shot_start": 35.836,
   "shot_end": 37.971,
   "out_on": 40.979,
   "out_off": 42.505,
   "drift_s": 5.143,
   "src_on": 46.6815,
   "src_off": 48.2078
  },
  {
   "shot": "S19",
   "text": "and leave your home feeling lighter and more peaceful.",
   "shot_start": 37.971,
   "shot_end": 40.607,
   "out_on": 42.855,
   "out_off": 45.828,
   "drift_s": 4.884,
   "src_on": 48.6462,
   "src_off": 51.6193
  },
  {
   "shot": "S20",
   "text": "No more bracing yourself before every request.",
   "shot_start": 40.607,
   "shot_end": 42.843,
   "out_on": 46.178,
   "out_off": 48.595,
   "drift_s": 5.571,
   "src_on": 52.1503,
   "src_off": 54.5672
  },
  {
   "shot": "S21",
   "text": "No more worrying about meltdowns or tantrums,",
   "shot_start": 42.843,
   "shot_end": 45.078,
   "out_on": 48.945,
   "out_off": 51.436,
   "drift_s": 6.102,
   "src_on": 55.2203,
   "src_off": 57.7109
  },
  {
   "shot": "S22",
   "text": "just a kid who names feelings,",
   "shot_start": 45.078,
   "shot_end": 46.246,
   "out_on": 51.786,
   "out_off": 53.466,
   "drift_s": 6.708,
   "src_on": 58.2388,
   "src_off": 59.9192
  },
  {
   "shot": "S23",
   "text": "calmer evenings",
   "shot_start": 46.246,
   "shot_end": 47.547,
   "out_on": 53.816,
   "out_off": 54.815,
   "drift_s": 7.57,
   "src_on": 60.5752,
   "src_off": 61.5744
  },
  {
   "shot": "S24",
   "text": "and time to enjoy them.",
   "shot_start": 47.547,
   "shot_end": 49.249,
   "out_on": 54.994,
   "out_off": 56.03,
   "drift_s": 7.447,
   "src_on": 61.7537,
   "src_off": 62.7896
  },
  {
   "shot": "S25",
   "text": "Add one feelings chart a day from the free Kids Mental Health Bundle",
   "shot_start": 49.249,
   "shot_end": 51.485,
   "out_on": 56.38,
   "out_off": 60.158,
   "drift_s": 7.131,
   "src_on": 64.8349,
   "src_off": 68.6127
  },
  {
   "shot": "S26",
   "text": "and give your kid support.",
   "shot_start": 51.485,
   "shot_end": 53.887,
   "out_on": 60.47,
   "out_off": 61.501,
   "drift_s": 8.985,
   "src_on": 68.925,
   "src_off": 69.9564
  },
  {
   "shot": "S27",
   "text": "Grab yours free.",
   "shot_start": 53.887,
   "shot_end": 55.055,
   "out_on": 61.756,
   "out_off": 62.353,
   "drift_s": 7.869,
   "src_on": 70.2111,
   "src_off": 70.8085
  }
 ],
