{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/tracking/cron-backfill",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sync-meta-spend",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sync-shopify-orders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/resolve-attribution",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/send-capi-batch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/daily-pnl-snapshot",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/backfill-attribution",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/survey-calibration",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/cleanup-old-events",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/classify-products",
      "schedule": "0 5 * * 0"
    },
    {
      "path": "/api/cron/refresh-exchange-rates",
      "schedule": "0 */6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
